#
# Copy this file to .env. The local .env file is ignored by Git and read by
# Make; keep application identity and release metadata in sce_sys/param.json.

PS5_HOST=192.168.1.100
FTP_PORT=2121
DEPLOY_DRY_RUN=0

# PACBREW_PACKAGES=sdl2 openssl

# Defaults to all available logical CPUs; lower this on memory-limited hosts.
# BUILD_JOBS=8
# USE_CCACHE=0

# Covers and wallpapers, fetched by the app for films that have none (optional).
# A free key for personal use: https://www.themoviedb.org/settings/api
# The build copies these lines into the app folder as mediathek.env (and
# never into the .zip). tools/fetch-posters.py reads them from here as well.
# TMDB_API_KEY=
# TMDB_LANGUAGE=en-US
# DNS_SERVER=

# The app speaks the console's language (English or German; English for any
# other). Set this to force one: en or de. It goes into mediathek.env as well.
# What "Automatic" means on the Settings page; a language chosen there wins.
# UI_LANGUAGE=auto
